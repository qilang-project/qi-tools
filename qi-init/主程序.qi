// qi-init — 奇语言项目脚手架(用 Qi 写的 Qi 工具)
//
// 用法:
//   qi-init 我的项目      在 ./我的项目/ 生成项目骨架
//   qi-init               默认名 我的奇程序
//
// 生成:qi.toml / 主程序.qi / 主程序_测.qi / README.md / .gitignore

包 主程序;

导入 标准库.命令行;
导入 标准库.输入输出;
导入 标准库.进程;

函数 生成清单(名称: 字符串) : 字符串 {
    变量 内容: 字符串 = "[包]\n";
    内容 = 内容 + "名称 = \"" + 名称 + "\"\n";
    内容 = 内容 + "版本 = \"0.1.0\"\n";
    内容 = 内容 + "入口 = \"主程序.qi\"\n";
    内容 = 内容 + "\n";
    内容 = 内容 + "# [依赖]\n";
    内容 = 内容 + "# 本地包 = \"../本地包\"\n";
    内容 = 内容 + "# Web = \"github.com/qilang-project/qi-web@main\"   # 远程依赖用 qi get 拉取\n";
    返回 内容;
}

函数 生成主程序(名称: 字符串) : 字符串 {
    变量 内容: 字符串 = "包 主程序;\n";
    内容 = 内容 + "\n";
    内容 = 内容 + "函数 问候(对象: 字符串) : 字符串 {\n";
    内容 = 内容 + "    返回 \"你好, \" + 对象 + \"!\";\n";
    内容 = 内容 + "}\n";
    内容 = 内容 + "\n";
    内容 = 内容 + "函数 入口() {\n";
    内容 = 内容 + "    打印行(问候(\"" + 名称 + "\"));\n";
    内容 = 内容 + "}\n";
    返回 内容;
}

函数 生成测试() : 字符串 {
    变量 内容: 字符串 = "// 由 qi test 自动发现(约定 *_测.qi);退出码 0 = 通过\n";
    内容 = 内容 + "\n";
    内容 = 内容 + "包 主程序;\n";
    内容 = 内容 + "\n";
    内容 = 内容 + "函数 问候(对象: 字符串) : 字符串 {\n";
    内容 = 内容 + "    返回 \"你好, \" + 对象 + \"!\";\n";
    内容 = 内容 + "}\n";
    内容 = 内容 + "\n";
    内容 = 内容 + "函数 断言相等(实际: 字符串, 期望: 字符串, 说明: 字符串) {\n";
    内容 = 内容 + "    如果 实际 != 期望 {\n";
    内容 = 内容 + "        打印行(\"断言失败: \" + 说明 + \" 实际=\" + 实际 + \" 期望=\" + 期望);\n";
    内容 = 内容 + "        抛出 \"测试失败\";\n";
    内容 = 内容 + "    }\n";
    内容 = 内容 + "}\n";
    内容 = 内容 + "\n";
    内容 = 内容 + "函数 入口() {\n";
    内容 = 内容 + "    断言相等(问候(\"世界\"), \"你好, 世界!\", \"问候拼接\");\n";
    内容 = 内容 + "    打印行(\"全部测试通过\");\n";
    内容 = 内容 + "}\n";
    返回 内容;
}

函数 生成说明(名称: 字符串) : 字符串 {
    变量 内容: 字符串 = "# " + 名称 + "\n";
    内容 = 内容 + "\n";
    内容 = 内容 + "奇语言(Qi)项目 —— 由 qi-init 生成。\n";
    内容 = 内容 + "\n";
    内容 = 内容 + "```bash\n";
    内容 = 内容 + "qi run 主程序.qi        # 编译并运行\n";
    内容 = 内容 + "qi test                # 跑 *_测.qi 测试\n";
    内容 = 内容 + "qi compile 主程序.qi -o " + 名称 + "   # 出可执行文件\n";
    内容 = 内容 + "qi get                 # 拉取 qi.toml 里的远程依赖\n";
    内容 = 内容 + "```\n";
    返回 内容;
}

函数 生成忽略(名称: 字符串) : 字符串 {
    变量 内容: 字符串 = "*.o\n";
    内容 = 内容 + "主程序\n";
    内容 = 内容 + 名称 + "\n";
    返回 内容;
}

函数 写出(路径: 字符串, 内容: 字符串) {
    如果 输入输出.写入文件(路径, 内容) != 1 {
        打印行("错误: 写入失败: " + 路径);
        进程.退出(1);
    }
    打印行("  创建 " + 路径);
}

函数 入口() {
    变量 应用 = 命令行.创建应用("qi-init");
    命令行.设置版本(应用, "0.1.0");
    命令行.设置关于(应用, "奇语言项目脚手架 | Scaffold a new Qi project");

    变量 名称参数 = 命令行.创建参数("名称");
    命令行.参数设置帮助(名称参数, "项目名(也是目录名),默认 我的奇程序");
    命令行.参数设置默认值(名称参数, "我的奇程序");
    命令行.应用添加参数(应用, 名称参数);

    变量 解析结果 = 命令行.解析(应用);
    如果 解析结果 <= 0 {
        进程.退出(1);
    }
    变量 名称: 字符串 = 命令行.获取值(解析结果, "名称");

    如果 输入输出.文件存在(名称) == 1 {
        打印行("错误: 目录或文件已存在: " + 名称 + "(不覆盖,换个名字或删掉它)");
        进程.退出(1);
    }

    如果 输入输出.创建目录(名称) != 1 {
        打印行("错误: 创建目录失败: " + 名称);
        进程.退出(1);
    }
    打印行("初始化奇语言项目: " + 名称);

    写出(名称 + "/qi.toml", 生成清单(名称));
    写出(名称 + "/主程序.qi", 生成主程序(名称));
    写出(名称 + "/主程序_测.qi", 生成测试());
    写出(名称 + "/README.md", 生成说明(名称));
    写出(名称 + "/.gitignore", 生成忽略(名称));

    打印行("");
    打印行("完成!下一步:");
    打印行("  cd " + 名称);
    打印行("  qi run 主程序.qi");
    打印行("  qi test");
}
