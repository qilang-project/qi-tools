// qifmt — 奇语言代码格式化器(用 Qi 写的 Qi 工具,自举工具链第二步)
//
// 与 qi-tools/src/formatter/mod.rs(Rust 版)逐字节对齐的"只动空白"实现:
//   - 逐行处理,绝不合并/拆分行
//   - 轻量字节扫描识别字符串(含 f"...")/字符字面量(含转义)/行注释/可嵌套块注释
//   - 只统计其外的 {} 【】 深度定行首缩进;未闭合 () （） [] 续行 +1 级
//   - 行首闭合符先回退;去行尾空白;连续空行折叠为 1;文件单结尾换行;幂等
//
// 用法:
//   qifmt 文件.qi            就地格式化(打印 已格式化/无需变更)
//   qifmt --check 文件.qi    只查不改,需要变更时退出码 1
//   qifmt --stdout 文件.qi   格式化结果打到标准输出,不写盘
//
// 与 Rust 版的差异:不做目录递归(-r),首版只收单文件。

包 主程序;

导入 标准库.命令行;
导入 标准库.输入输出;
导入 标准库.进程;
导入 标准库.字节切片 作为 缓冲;

// ===== 跨行扫描状态(对应 Rust 版 DepthState / LeadingClosers) =====

变量 注释深度: 整数 = 0;   // 块注释嵌套深度(Qi 的 /* */ 支持嵌套)
变量 花深度: 整数 = 0;     // 花括号({} / 【】)深度,决定缩进级别
变量 圆深度: 整数 = 0;     // 圆/方括号(() / （） / [])深度,用于续行缩进
变量 首花闭合: 整数 = 0;   // 行首连续闭合花括号数
变量 首圆闭合: 整数 = 0;   // 行首连续闭合圆/方括号数

// UTF-8 首字节 → 该字符的字节宽(CJK 括号是 3 字节,切片必须按完整序列走)
函数 码宽(b: 整数): 整数 {
    如果 b >= 240 { 返回 4; }
    如果 b >= 224 { 返回 3; }
    如果 b >= 192 { 返回 2; }
    返回 1;
}

// 位置 i 处若是空白,返回其字节宽;否则返回 0。
// 覆盖 ASCII 空白 + U+00A0(C2 A0) + U+3000 全角空格(E3 80 80),
// 对实际源码与 Rust char::is_whitespace 等价。
函数 空白宽(源: 整数, 界: 整数, i: 整数): 整数 {
    变量 b = 缓冲.获取(源, i);
    如果 b == 32 { 返回 1; }
    如果 b == 9 { 返回 1; }
    如果 b == 13 { 返回 1; }
    如果 b == 10 { 返回 1; }
    如果 b == 11 { 返回 1; }
    如果 b == 12 { 返回 1; }
    如果 b == 194 {
        如果 i + 1 < 界 {
            如果 缓冲.获取(源, i + 1) == 160 { 返回 2; }
        }
    }
    如果 b == 227 {
        如果 i + 2 < 界 {
            如果 缓冲.获取(源, i + 1) == 128 {
                如果 缓冲.获取(源, i + 2) == 128 { 返回 3; }
            }
        }
    }
    返回 0;
}

// 跳过行首空白,返回首个非空白字节位置
函数 修剪首(源: 整数, 首: 整数, 尾: 整数): 整数 {
    变量 i = 首;
    当 i < 尾 {
        变量 宽 = 空白宽(源, 尾, i);
        如果 宽 == 0 { 跳出; }
        i = i + 宽;
    }
    返回 i;
}

// 返回去掉行尾空白后的结束位置(前向扫描,避免倒着切多字节序列)
函数 修剪尾(源: 整数, 首: 整数, 尾: 整数): 整数 {
    变量 i = 首;
    变量 末 = 首;
    当 i < 尾 {
        变量 宽 = 空白宽(源, 尾, i);
        如果 宽 > 0 {
            i = i + 宽;
        } 否则 {
            i = i + 1;
            末 = i;
        }
    }
    返回 末;
}

// 行首连续闭合符统计(允许闭合符之间有空白),如 `};`、`} 否则 {`、`);`
// 结果写入全局 首花闭合 / 首圆闭合
函数 统计行首闭合(源: 整数, 首: 整数, 尾: 整数) {
    首花闭合 = 0;
    首圆闭合 = 0;
    变量 i = 首;
    当 i < 尾 {
        变量 宽 = 空白宽(源, 尾, i);
        如果 宽 > 0 {
            i = i + 宽;
            继续;
        }
        变量 b = 缓冲.获取(源, i);
        如果 b == 125 { 首花闭合 = 首花闭合 + 1; i = i + 1; 继续; }   // }
        如果 b == 41 { 首圆闭合 = 首圆闭合 + 1; i = i + 1; 继续; }    // )
        如果 b == 93 { 首圆闭合 = 首圆闭合 + 1; i = i + 1; 继续; }    // ]
        如果 b == 227 {   // 】 = E3 80 91
            如果 i + 2 < 尾 {
                如果 缓冲.获取(源, i + 1) == 128 {
                    如果 缓冲.获取(源, i + 2) == 145 {
                        首花闭合 = 首花闭合 + 1;
                        i = i + 3;
                        继续;
                    }
                }
            }
            返回;
        }
        如果 b == 239 {   // ） = EF BC 89
            如果 i + 2 < 尾 {
                如果 缓冲.获取(源, i + 1) == 188 {
                    如果 缓冲.获取(源, i + 2) == 137 {
                        首圆闭合 = 首圆闭合 + 1;
                        i = i + 3;
                        继续;
                    }
                }
            }
            返回;
        }
        返回;
    }
}

// 扫描一行,更新全局括号/注释深度。
// 跳过字符串字面量(含 f"...")、字符字面量、行注释与可嵌套块注释,
// 保证注释和字符串里的括号不影响缩进计算。
函数 扫描行(源: 整数, 首: 整数, 尾: 整数) {
    变量 i = 首;
    当 i < 尾 {
        变量 b = 缓冲.获取(源, i);

        // 块注释内部:只找 */ 与嵌套的 /*
        如果 注释深度 > 0 {
            如果 b == 42 {   // '*'
                如果 i + 1 < 尾 {
                    如果 缓冲.获取(源, i + 1) == 47 {
                        注释深度 = 注释深度 - 1;
                        i = i + 2;
                        继续;
                    }
                }
            }
            如果 b == 47 {   // '/'
                如果 i + 1 < 尾 {
                    如果 缓冲.获取(源, i + 1) == 42 {
                        注释深度 = 注释深度 + 1;
                        i = i + 2;
                        继续;
                    }
                }
            }
            i = i + 码宽(b);
            继续;
        }

        如果 b == 47 {   // '/'
            如果 i + 1 < 尾 {
                变量 下 = 缓冲.获取(源, i + 1);
                如果 下 == 47 { 返回; }   // 行注释:本行剩余部分全部忽略
                如果 下 == 42 {           // 块注释开始
                    注释深度 = 注释深度 + 1;
                    i = i + 2;
                    继续;
                }
            }
            i = i + 1;
            继续;
        }

        如果 b == 34 {   // '"' 字符串字面量(f"..." 的 f 前缀无需特判)
            i = i + 1;
            当 i < 尾 {
                变量 s = 缓冲.获取(源, i);
                如果 s == 34 { 跳出; }
                如果 s == 92 { i = i + 1; }   // 跳过转义字符
                i = i + 1;
            }
            i = i + 1;   // 跳过闭引号(或行尾)
            继续;
        }

        如果 b == 39 {   // '\'' 字符字面量:'x' 或 '\x';不匹配则按普通字符处理
            变量 命中 = 0;
            如果 i + 1 < 尾 {
                如果 缓冲.获取(源, i + 1) == 92 {
                    如果 i + 2 < 尾 {
                        变量 引位 = i + 2 + 码宽(缓冲.获取(源, i + 2));
                        如果 引位 < 尾 {
                            如果 缓冲.获取(源, 引位) == 39 {
                                i = 引位 + 1;
                                命中 = 1;
                            }
                        }
                    }
                }
            }
            如果 命中 == 0 {
                如果 i + 1 < 尾 {
                    变量 引位二 = i + 1 + 码宽(缓冲.获取(源, i + 1));
                    如果 引位二 < 尾 {
                        如果 缓冲.获取(源, 引位二) == 39 {
                            i = 引位二 + 1;
                            命中 = 1;
                        }
                    }
                }
            }
            如果 命中 == 1 { 继续; }
            i = i + 1;
            继续;
        }

        如果 b == 123 { 花深度 = 花深度 + 1; i = i + 1; 继续; }   // {
        如果 b == 125 {                                            // }
            如果 花深度 > 0 { 花深度 = 花深度 - 1; }
            i = i + 1;
            继续;
        }
        如果 b == 40 { 圆深度 = 圆深度 + 1; i = i + 1; 继续; }    // (
        如果 b == 91 { 圆深度 = 圆深度 + 1; i = i + 1; 继续; }    // [
        如果 b == 41 {                                             // )
            如果 圆深度 > 0 { 圆深度 = 圆深度 - 1; }
            i = i + 1;
            继续;
        }
        如果 b == 93 {                                             // ]
            如果 圆深度 > 0 { 圆深度 = 圆深度 - 1; }
            i = i + 1;
            继续;
        }
        如果 b == 227 {   // 【 = E3 80 90 / 】 = E3 80 91
            如果 i + 2 < 尾 {
                如果 缓冲.获取(源, i + 1) == 128 {
                    变量 尾字 = 缓冲.获取(源, i + 2);
                    如果 尾字 == 144 {
                        花深度 = 花深度 + 1;
                        i = i + 3;
                        继续;
                    }
                    如果 尾字 == 145 {
                        如果 花深度 > 0 { 花深度 = 花深度 - 1; }
                        i = i + 3;
                        继续;
                    }
                }
            }
            i = i + 3;
            继续;
        }
        如果 b == 239 {   // （ = EF BC 88 / ） = EF BC 89
            如果 i + 2 < 尾 {
                如果 缓冲.获取(源, i + 1) == 188 {
                    变量 尾字二 = 缓冲.获取(源, i + 2);
                    如果 尾字二 == 136 {
                        圆深度 = 圆深度 + 1;
                        i = i + 3;
                        继续;
                    }
                    如果 尾字二 == 137 {
                        如果 圆深度 > 0 { 圆深度 = 圆深度 - 1; }
                        i = i + 3;
                        继续;
                    }
                }
            }
            i = i + 3;
            继续;
        }
        i = i + 码宽(b);
    }
}

// 两个字符串逐字节相同返回 1(注意:文本.等于 里的 等于 是保留字,语法层调不到)
函数 文本相同(甲: 字符串, 乙: 字符串): 整数 {
    变量 甲切 = 缓冲.从字符串(甲);
    变量 乙切 = 缓冲.从字符串(乙);
    变量 差 = 缓冲.比较(甲切, 乙切);
    缓冲.释放切片(甲切);
    缓冲.释放切片(乙切);
    如果 差 == 0 { 返回 1; }
    返回 0;
}

// 把源字节 [首, 尾) 追加到输出缓冲
函数 追加片段(输出: 整数, 源: 整数, 首: 整数, 尾: 整数) {
    如果 尾 > 首 {
        变量 片 = 缓冲.切片(源, 首, 尾 - 首);
        缓冲.追加切片(输出, 片);
        缓冲.释放切片(片);
    }
}

// 核心:重排缩进(对应 Rust 版 reindent)。只动空白,非空白内容逐字节一致。
函数 格式化全文(源码: 字符串): 字符串 {
    变量 源 = 缓冲.从字符串(源码);
    变量 总长 = 缓冲.长度(源);
    变量 输出 = 缓冲.创建带容量(总长 + 16);

    注释深度 = 0;
    花深度 = 0;
    圆深度 = 0;

    变量 待空行 = 0;
    变量 已写 = 0;
    变量 行首 = 0;

    当 行首 < 总长 {
        // 找行尾(\n 或文件末尾);与 Rust source.lines() 的切行一致
        变量 行尾 = 行首;
        当 行尾 < 总长 {
            如果 缓冲.获取(源, 行尾) == 10 { 跳出; }
            行尾 = 行尾 + 1;
        }

        如果 注释深度 > 0 {
            // 起始于块注释内部的行:原样保留(仅去行尾空白),不重排缩进,
            // 以免破坏注释内的对齐/示意图。仍需扫描以更新注释/括号状态。
            如果 待空行 == 1 {
                缓冲.追加字节(输出, 10);
                待空行 = 0;
            }
            追加片段(输出, 源, 行首, 修剪尾(源, 行首, 行尾));
            缓冲.追加字节(输出, 10);
            已写 = 1;
            扫描行(源, 行首, 行尾);
            行首 = 行尾 + 1;
            继续;
        }

        变量 头 = 修剪首(源, 行首, 行尾);
        变量 净尾 = 修剪尾(源, 头, 行尾);
        如果 头 >= 净尾 {
            // 空行:连续空行折叠为一个;文件首部空行丢弃
            如果 已写 == 1 { 待空行 = 1; }
            行首 = 行尾 + 1;
            继续;
        }

        如果 待空行 == 1 {
            缓冲.追加字节(输出, 10);
            待空行 = 0;
        }

        // 行首的闭合符决定本行相对当前深度回退多少级
        统计行首闭合(源, 头, 净尾);
        变量 级别 = 花深度 - 首花闭合;
        如果 级别 < 0 { 级别 = 0; }
        如果 圆深度 - 首圆闭合 > 0 {
            // 未闭合圆括号/方括号内的续行统一多缩进一级
            级别 = 级别 + 1;
        }

        变量 k = 0;
        当 k < 级别 {
            缓冲.追加字符串(输出, "    ");
            k = k + 1;
        }
        追加片段(输出, 源, 头, 净尾);
        缓冲.追加字节(输出, 10);
        已写 = 1;
        扫描行(源, 头, 净尾);
        行首 = 行尾 + 1;
    }

    变量 输出文本: 字符串 = 缓冲.转字符串(输出);
    缓冲.释放切片(源);
    缓冲.释放切片(输出);
    返回 输出文本;
}

函数 入口() {
    变量 应用 = 命令行.创建应用("qifmt");
    命令行.设置版本(应用, "0.1.0");
    命令行.设置关于(应用, "奇语言代码格式化器(只动空白) | Qi source formatter");

    变量 文件参数 = 命令行.创建参数("文件");
    命令行.参数设置帮助(文件参数, "要格式化的 .qi 源文件");
    命令行.参数设置必需(文件参数, 1);
    命令行.应用添加参数(应用, 文件参数);

    变量 只查参数 = 命令行.创建参数("check");
    命令行.参数设置长名(只查参数, "check");
    命令行.参数设置为标志(只查参数);
    命令行.参数设置帮助(只查参数, "只检查不修改;需要变更时退出码 1");
    命令行.应用添加参数(应用, 只查参数);

    变量 标准输出参数 = 命令行.创建参数("stdout");
    命令行.参数设置长名(标准输出参数, "stdout");
    命令行.参数设置为标志(标准输出参数);
    命令行.参数设置帮助(标准输出参数, "格式化结果打到标准输出,不写盘");
    命令行.应用添加参数(应用, 标准输出参数);

    变量 解析结果 = 命令行.解析(应用);
    如果 解析结果 <= 0 {
        进程.退出(1);
    }
    变量 路径: 字符串 = 命令行.获取值(解析结果, "文件");
    变量 只查 = 命令行.获取标志(解析结果, "check");
    变量 到标准输出 = 命令行.获取标志(解析结果, "stdout");

    如果 输入输出.文件存在(路径) != 1 {
        打印行("错误: 文件不存在: " + 路径);
        进程.退出(1);
    }

    变量 原文: 字符串 = 输入输出.读取文件(路径);
    变量 新文: 字符串 = 格式化全文(原文);
    变量 相同 = 文本相同(原文, 新文);

    如果 到标准输出 == 1 {
        打印(新文);
        返回;
    }

    如果 只查 == 1 {
        如果 相同 == 1 {
            打印行("无需变更: " + 路径);
        } 否则 {
            打印行("需要格式化: " + 路径);
            进程.退出(1);
        }
        返回;
    }

    如果 相同 == 1 {
        打印行("无需变更: " + 路径);
        返回;
    }
    如果 输入输出.写入文件(路径, 新文) != 1 {
        打印行("错误: 写入失败: " + 路径);
        进程.退出(1);
    }
    打印行("已格式化: " + 路径);
}
